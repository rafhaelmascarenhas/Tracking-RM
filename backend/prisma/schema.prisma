generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Workspace {
  id                String   @id @default(uuid())
  name              String
  meta_pixel_id     String?
  meta_capi_token   String?
  // CTWA (business_messaging) EXIGE page_id OU whatsapp_business_account_id no
  // evento, senão a Meta recusa (subcode 2804116). Basta um dos dois.
  meta_page_id      String?
  meta_waba_id      String?
  // Token com permissão ads_read — resolve ID de campanha/conjunto/anúncio pra nome.
  // Opcional: se vazio, tenta o meta_capi_token (system user costuma ter ads_read).
  meta_ads_token    String?
  google_ads_id     String?
  gtm_id            String?
  webhook_url       String?
  // uazapi — configurado 1x, reutilizado por todos os números do workspace
  uazapi_url         String?
  uazapi_admin_token String?
  // evolution api — provider alternativo; apikey global serve a todas as instâncias
  evolution_url      String?
  evolution_api_key  String?
  created_at        DateTime @default(now())

  whatsappConnections WhatsappConnection[]
  leads               Lead[]
  journeyStages       JourneyStage[]
  trackableMessages   TrackableMessage[]
  trackableLinks      TrackableLink[]
  rotators            Rotator[]
  group_rotators      GroupRotator[]
  group_members       GroupMember[]
  conversionTriggers  ConversionTrigger[]

  @@map("workspaces")
}

model WhatsappConnection {
  id           String   @id @default(uuid())
  workspace_id String
  provider     String   @default("UAZAPI") // UAZAPI | EVOLUTION
  session_name String   // = nome da instância no provider (casa com webhook body.instance)
  status       String   @default("DISCONNECTED") // CONNECTED | DISCONNECTED | CONNECTING
  phone_number String?
  uazapi_token String?  // token da instância retornado pela uazapi no init (não usado no Evolution)
  profile_name String?  // nome do perfil WhatsApp após conectar
  is_imported  Boolean  @default(false) // true = importado por token externo; não apaga da uazapi ao deletar
  created_at   DateTime @default(now())

  workspace      Workspace       @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  rotatorTargets RotatorTarget[]
  groupRotators  GroupRotator[]
  leads          Lead[]

  @@map("whatsapp_connections")
}

model Lead {
  id                     String   @id @default(uuid())
  workspace_id           String
  phone_number           String
  name                   String?
  utm_source             String?
  utm_medium             String?
  utm_campaign           String?
  utm_term               String?
  utm_content            String?
  current_journey_stage_id String?
  // Atribuição fina (Fase 2 — rotador)
  fbclid                 String?
  click_ip               String?
  click_user_agent       String?
  click_time             DateTime?
  // Atribuição CTWA (anúncio de mensagem direta — Click to WhatsApp)
  ctwa_clid              String?
  // Número WhatsApp que recebeu a primeira mensagem do lead
  whatsapp_connection_id String?
  created_at             DateTime @default(now())

  workspace          Workspace          @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  journeyStage       JourneyStage?      @relation(fields: [current_journey_stage_id], references: [id])
  whatsappConnection WhatsappConnection? @relation(fields: [whatsapp_connection_id], references: [id])
  messages           Message[]

  @@unique([workspace_id, phone_number])
  @@map("leads")
}

model Message {
  id        String   @id @default(uuid())
  lead_id   String
  direction String   // INBOUND | OUTBOUND
  content   String
  timestamp DateTime @default(now())

  lead Lead @relation(fields: [lead_id], references: [id], onDelete: Cascade)

  @@map("messages")
}

model JourneyStage {
  id             String   @id @default(uuid())
  workspace_id   String
  name           String
  order_index    Int
  system_default Boolean  @default(false)
  // Origem do funil: cada aba (CTWA/WhatsApp direto vs Rotador) tem suas etapas.
  origin         String   @default("ctwa") // ctwa | rotator
  // Termo-chave: quando o atendente envia essa frase, o lead move pra esta etapa
  // e dispara os conversionEvents dela (1x por lead, ver StageFired). null = sem auto.
  keyword          String?
  is_sale          Boolean @default(false) // etapa representa uma venda
  is_first_contact Boolean @default(false) // etapa representa o primeiro contato
  created_at     DateTime @default(now())

  workspace         Workspace         @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  leads             Lead[]
  conversionEvents  ConversionEvent[]

  @@map("journey_stages")
}

// Log de todo disparo de evento pro pixel (CAPI). Alimenta a tela "Disparos de
// Pixel" com o RETORNO da Meta — visibilidade + debug (ex: recusa de evento).
model PixelFire {
  id               String   @id @default(uuid())
  workspace_id     String
  lead_id          String
  journey_stage_id String?
  platform         String   // META | GOOGLE
  event_name       String   // nome REALMENTE enviado (após remap Lead->LeadSubmitted)
  action_source    String?  // website | business_messaging | system_generated
  value            Float?
  currency         String?
  status           String   // success | error
  response         String?  // fbtrace_id / corpo do erro da Meta (truncado)
  fired_at         DateTime @default(now())

  @@index([workspace_id, fired_at])
  @@map("pixel_fires")
}

// Cache de nome de objeto do Meta Ads (campanha/conjunto/anúncio).
// A URL do anúncio manda ID quando configurada com {{campaign.id}} em vez de
// {{campaign.name}}; aqui guardamos o nome resolvido via Graph API pra não
// bater na API a cada exibição do lead.
model MetaAdName {
  meta_id    String   @id // ID do objeto no Meta (campanha, conjunto ou anúncio)
  name       String
  fetched_at DateTime @default(now())

  @@map("meta_ad_names")
}

// Dedupe do disparo de etapa: garante que mover um lead pra uma etapa dispara
// os eventos dela só 1x (mesmo se o atendente repetir o termo-chave).
model StageFired {
  id               String   @id @default(uuid())
  lead_id          String
  journey_stage_id String
  fired_at         DateTime @default(now())

  @@unique([lead_id, journey_stage_id])
  @@map("stage_fired")
}

model ConversionEvent {
  id               String   @id @default(uuid())
  journey_stage_id String
  platform         String   // META | GOOGLE
  // Origem do lead a que este evento se aplica. CTWA e rotador têm eventos
  // válidos diferentes (business_messaging vs website), então são individuais.
  source           String   @default("any") // ctwa | rotator | any
  event_name       String   // Purchase | Lead | ViewContent | etc.
  value            Float?   // valor padrão do evento (override por lead ao marcar conversão)
  currency         String   @default("BRL")
  created_at       DateTime @default(now())

  journeyStage JourneyStage @relation(fields: [journey_stage_id], references: [id], onDelete: Cascade)

  @@map("conversion_events")
}

model TrackableMessage {
  id           String   @id @default(uuid())
  workspace_id String
  base_text    String
  utm_source   String?
  utm_medium   String?
  utm_campaign String?
  utm_term     String?
  utm_content  String?
  created_at   DateTime @default(now())

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@map("trackable_messages")
}

model TrackableLink {
  id              String   @id @default(uuid())
  workspace_id    String
  short_code      String   @unique
  destination_url String
  utm_source      String?
  utm_medium      String?
  utm_campaign    String?
  utm_term        String?
  utm_content     String?
  created_at      DateTime @default(now())

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@map("trackable_links")
}

model Rotator {
  id             String   @id @default(uuid())
  workspace_id   String
  short_code     String   @unique
  name           String
  distribution   String   @default("ROUND_ROBIN") // ROUND_ROBIN | WEIGHTED | FALLBACK
  prefilled_text String
  utm_source     String?
  utm_medium     String?
  utm_campaign   String?
  utm_term       String?
  utm_content    String?
  rr_counter     Int      @default(0)
  active         Boolean  @default(true)
  // Landing page (Meta ads)
  use_landing    Boolean  @default(false)
  landing_logo   String?
  landing_title  String?
  landing_cta    String?
  redirect_seconds Int    @default(3) // contagem antes do auto-redirect (landing do link Meta)
  // Token na mensagem — false = usa só fallback 6h (sem código visível)
  hide_token          Boolean  @default(false)
  distribute_offline  Boolean  @default(false)
  created_at     DateTime @default(now())

  workspace Workspace       @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  targets   RotatorTarget[]
  clicks    RotatorClick[]

  @@map("rotators")
}

model RotatorTarget {
  id            String  @id @default(uuid())
  rotator_id    String
  connection_id String
  weight        Int     @default(1)
  priority      Int     @default(0)
  active        Boolean @default(true)

  rotator    Rotator            @relation(fields: [rotator_id], references: [id], onDelete: Cascade)
  connection WhatsappConnection @relation(fields: [connection_id], references: [id], onDelete: Cascade)

  @@unique([rotator_id, connection_id])
  @@map("rotator_targets")
}

model RotatorClick {
  id            String    @id @default(uuid())
  rotator_id    String
  connection_id String
  token         String?   @unique
  fbclid        String?
  gclid         String?
  utm_source    String?
  utm_medium    String?
  utm_campaign  String?
  utm_term      String?
  utm_content   String?
  ip_address    String?
  user_agent    String?
  lead_id       String?
  status        String    @default("pending") // pending | matched
  matched_at    DateTime?
  created_at    DateTime  @default(now())

  rotator Rotator @relation(fields: [rotator_id], references: [id], onDelete: Cascade)

  @@map("rotator_clicks")
}

// Rotador de LINKS DE GRUPO do WhatsApp (chat.whatsapp.com/...).
// Mesma mecânica do Rotator, mas o destino é um convite de grupo, não um número.
// Diferenças relevantes:
//  - não há prefilled_text/token: grupo não passa por wa.me, então não dá pra casar
//    o clique com uma conversa. Por ora o rastreio é só clique + CAPI (ver GroupClick).
//  - pixel/CAPI/GTM podem ser próprios do rotador (fallback: os do workspace).
model GroupRotator {
  id           String  @id @default(uuid())
  workspace_id String
  short_code   String  @unique
  name         String
  distribution String  @default("ROUND_ROBIN") // ROUND_ROBIN | WEIGHTED | FALLBACK
  utm_source   String?
  utm_medium   String?
  utm_campaign String?
  utm_term     String?
  utm_content  String?
  rr_counter   Int     @default(0)
  active       Boolean @default(true)
  // Número usado pra ler os grupos (resolver o convite e receber o evento de
  // entrada). Precisa ser Evolution e admin dos grupos. Nulo = rotador só
  // redireciona, sem contagem de membros — que é como todo rotador antigo nasceu.
  connection_id String?
  // Landing page (Meta ads)
  use_landing      Boolean @default(false)
  landing_logo     String?
  landing_title    String?
  landing_cta      String?
  redirect_seconds Int     @default(3)
  // Pixel próprio deste rotador — se nulo, cai no do workspace.
  meta_pixel_id   String?
  meta_capi_token String?
  gtm_id          String?
  created_at      DateTime @default(now())

  workspace  Workspace           @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  connection WhatsappConnection? @relation(fields: [connection_id], references: [id], onDelete: SetNull)
  targets    GroupTarget[]
  clicks     GroupClick[]

  @@map("group_rotators")
}

model GroupTarget {
  id         String  @id @default(uuid())
  rotator_id String
  name       String  @default("")
  invite_url String
  weight     Int     @default(1)
  priority   Int     @default(0)
  active     Boolean @default(true)
  // Grupo do WhatsApp lota (1024 membros). Ao bater max_clicks o grupo sai do
  // pool automaticamente e o próximo assume. Nulo = sem limite.
  max_clicks   Int?
  clicks_count Int  @default(0)
  // JID do grupo (ex: 120363...@g.us). Resolvido pelo código do convite via
  // provider (Evolution: GET /group/inviteInfo). É o que liga o evento de entrada
  // ao target — sem ele o membro entra sem target_id.
  group_jid    String? @unique

  rotator GroupRotator  @relation(fields: [rotator_id], references: [id], onDelete: Cascade)
  clicks  GroupClick[]
  members GroupMember[]

  @@map("group_targets")
}

// Entrada de pessoa em grupo do rotador. Alimentado pelo evento
// group-participants.update (action=add) do provider — exige que o número
// conectado seja ADMIN do grupo, senão o provider não recebe o evento.
//
// Atribuição ao anúncio é PROBABILÍSTICA por enquanto: o clique tem fbclid mas
// não tem telefone; a entrada tem telefone mas não tem fbclid. O elo é a janela
// de tempo no mesmo target. Ver docs/specs para o modelo determinístico.
model GroupMember {
  id           String    @id @default(uuid())
  workspace_id String
  rotator_id   String?
  target_id    String?
  group_jid    String
  phone_number String
  joined_at    DateTime  @default(now())
  // Saída do grupo (action=remove). Nulo = ainda dentro.
  left_at      DateTime?

  workspace Workspace    @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  target    GroupTarget? @relation(fields: [target_id], references: [id], onDelete: SetNull)

  @@unique([group_jid, phone_number])
  @@index([workspace_id, joined_at])
  @@map("group_members")
}

model GroupClick {
  id         String   @id @default(uuid())
  rotator_id String
  target_id  String
  fbclid     String?
  gclid      String?
  utm_source String?
  utm_medium String?
  utm_campaign String?
  utm_term   String?
  utm_content String?
  ip_address String?
  user_agent String?
  created_at DateTime @default(now())

  rotator GroupRotator @relation(fields: [rotator_id], references: [id], onDelete: Cascade)
  target  GroupTarget  @relation(fields: [target_id], references: [id], onDelete: Cascade)

  @@map("group_clicks")
}

// Gatilho de evento de conversão por mensagem (modelo Tintim + atribuição do rotador).
// Dispara fireMetaCapi pro lead quando a condição bate. fbclid do lead = atribuição ao anúncio.
model ConversionTrigger {
  id           String   @id @default(uuid())
  workspace_id String
  name         String   // rótulo, ex: "Lead — abriu conversa"
  platform     String   @default("META") // META | GOOGLE
  event_name   String   // Lead | Purchase | ViewContent | etc
  value        Float?
  currency     String   @default("BRL")
  trigger_type String   // conversation_open | phrase
  phrase       String?  // usado quando trigger_type = phrase
  direction    String   @default("any") // lead | attendant | any (quem manda a frase)
  // Escopo: rotator_id setado = só esse rotador; only_rotator = qualquer rotador; ambos vazios = todos os leads
  only_rotator Boolean  @default(false)
  rotator_id   String?
  active       Boolean  @default(true)
  created_at   DateTime @default(now())

  workspace Workspace          @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  fired     ConversionFired[]

  @@map("conversion_triggers")
}

// Dedupe: garante que cada gatilho dispara no máximo 1x por lead.
model ConversionFired {
  id         String   @id @default(uuid())
  trigger_id String
  lead_id    String
  fired_at   DateTime @default(now())

  trigger ConversionTrigger @relation(fields: [trigger_id], references: [id], onDelete: Cascade)

  @@unique([trigger_id, lead_id])
  @@map("conversions_fired")
}
