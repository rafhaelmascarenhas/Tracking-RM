DATABASE_URL="postgresql://user:password@host:5432/rm_app"

# Acesso ao painel: senha unica trocada por um JWT de 30 dias.
# Sem PANEL_PASSWORD a auth fica DESLIGADA (ok em dev, nunca em producao).
# PANEL_JWT_SECRET e obrigatorio junto com a senha: string aleatoria longa
# (ex: openssl rand -base64 48). Trocar o segredo desloga todo mundo.
PANEL_PASSWORD="senha-do-painel"
PANEL_JWT_SECRET="string-aleatoria-longa"

# Supabase JWT secret (found in Project Settings > API)
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# Redis (BullMQ)
REDIS_URL="redis://localhost:6379"

PORT=3001

# URL pública do backend (a uazapi precisa alcançá-la para entregar webhooks).
# Em dev local use um túnel (ex: ngrok). Sem isso, cai no host da requisição.
PUBLIC_BASE_URL="https://seu-dominio-publico.com"

# --- Google Ads (import de conversao offline) ---
# Dev token: Ads > Ferramentas > Central de API (pedir na conta MCC, nao na filha)
GOOGLE_ADS_DEVELOPER_TOKEN=
# OAuth do app (Google Cloud Console > Credenciais > ID do cliente OAuth "App para computador")
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Refresh token com escopo https://www.googleapis.com/auth/adwords
GOOGLE_ADS_REFRESH_TOKEN=
# ID da MCC (so digitos). Obrigatorio quando a conta alvo e filha de um gerenciador.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Fuso da conta Ads, usado no conversionDateTime. Default -03:00.
GOOGLE_ADS_TIMEZONE_OFFSET=-03:00
# true = valida o payload sem gravar conversao (util no primeiro teste)
GOOGLE_ADS_VALIDATE_ONLY=false
